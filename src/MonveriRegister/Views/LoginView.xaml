<UserControl x:Class="MonveriRegister.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MonveriRegister.ViewModels"
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <!-- Logo / Title -->
                <TextBlock Text="Monveri Register" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Point of Sale" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Store Connection Panel -->
                <StackPanel Visibility="{Binding IsStoreConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="Connect to Store" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Server URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RegisterTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Store API Key" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding StoreKey, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource RegisterTextBox}" Margin="0,0,0,16"/>

                    <Button Content="Connect" Command="{Binding ConnectToStoreCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBool}}"/>
                </StackPanel>

                <!-- Employee PIN Panel -->
                <StackPanel Visibility="{Binding ShowPinEntry, Converter={StaticResource BoolToVis}}">
                    <!-- Connected store info -->
                    <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding StoreName}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Connected" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                            <Button Content="Disconnect" Command="{Binding DisconnectStoreCommand}"
                                    Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                                    VerticalAlignment="Center" FontSize="12" Padding="8,4"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Enter PIN" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- PIN input - captures keyboard input, displays as masked dots -->
                    <TextBox x:Name="PinInput" Text="{Binding EmployeePin, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                             HorizontalAlignment="Center" MinWidth="200" MaxLength="8"
                             TextAlignment="Center" Margin="0,0,0,16"
                             Style="{StaticResource RegisterTextBox}"
                             IsTabStop="True">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding EmployeeLoginCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Numpad -->
                    <UniformGrid Columns="3" HorizontalAlignment="Center" MaxWidth="240">
                        <Button Content="1" Command="{Binding AppendPinCommand}" CommandParameter="1" Style="{StaticResource NumpadButton}"/>
                        <Button Content="2" Command="{Binding AppendPinCommand}" CommandParameter="2" Style="{StaticResource NumpadButton}"/>
                        <Button Content="3" Command="{Binding AppendPinCommand}" CommandParameter="3" Style="{StaticResource NumpadButton}"/>
                        <Button Content="4" Command="{Binding AppendPinCommand}" CommandParameter="4" Style="{StaticResource NumpadButton}"/>
                        <Button Content="5" Command="{Binding AppendPinCommand}" CommandParameter="5" Style="{StaticResource NumpadButton}"/>
                        <Button Content="6" Command="{Binding AppendPinCommand}" CommandParameter="6" Style="{StaticResource NumpadButton}"/>
                        <Button Content="7" Command="{Binding AppendPinCommand}" CommandParameter="7" Style="{StaticResource NumpadButton}"/>
                        <Button Content="8" Command="{Binding AppendPinCommand}" CommandParameter="8" Style="{StaticResource NumpadButton}"/>
                        <Button Content="9" Command="{Binding AppendPinCommand}" CommandParameter="9" Style="{StaticResource NumpadButton}"/>
                        <Button Content="CLR" Command="{Binding ClearPinCommand}" Style="{StaticResource NumpadButton}" FontSize="14"/>
                        <Button Content="0" Command="{Binding AppendPinCommand}" CommandParameter="0" Style="{StaticResource NumpadButton}"/>
                        <Button Content="DEL" Command="{Binding BackspacePinCommand}" Style="{StaticResource NumpadButton}" FontSize="14"/>
                    </UniformGrid>

                    <Button Content="Log In" Command="{Binding EmployeeLoginCommand}"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Margin="0,16,0,0"
                            IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InverseBool}}"/>
                </StackPanel>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
