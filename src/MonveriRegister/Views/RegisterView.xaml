<UserControl x:Class="MonveriRegister.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MonveriRegister.ViewModels"
             d:DataContext="{d:DesignInstance vm:RegisterViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Payment button base style -->
        <Style x:Key="PaymentBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#D4710A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8A54C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF3E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE0B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Quick button style -->
        <Style x:Key="QuickBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8A54C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#1A6AA5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF8EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE8CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#E8A54C">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ TOP BAR ============ -->
        <Border Grid.Row="0" Background="#1A6AA5" Padding="12,6">
            <DockPanel>
                <!-- Left: Session/Employee/Time -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#E8A54C">
                        <Run Text="{Binding SessionInfo, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="10" Foreground="#FFD280">
                        <Run Text="{Binding EmployeeName, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Right: Sync + Close -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Training badge -->
                    <Border CornerRadius="10" Padding="8,3" Margin="4,0" Background="#D97706"
                            Visibility="{Binding IsTraining, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="TRAINING" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <!-- Sync dot -->
                    <Ellipse Width="10" Height="10" Margin="8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#DC2626"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="#16A34A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- Close register -->
                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                            Command="{Binding CloseRegisterCommand}" ToolTip="Close Register"/>
                </StackPanel>

                <!-- Center: Store name -->
                <TextBlock Text="{Binding StoreName, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                           Foreground="#E8A54C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ============ MAIN CONTENT ============ -->
        <Grid Grid.Row="1" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT PANEL: Search + Cart ===== -->
            <Border Grid.Column="0" Background="White" BorderBrush="#1A6AA5" BorderThickness="2" Margin="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search bar -->
                    <DockPanel Grid.Row="0" Margin="6">
                        <Button DockPanel.Dock="Right" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Background="#1A6AA5" Foreground="White" BorderThickness="0" Padding="10,6"
                                Cursor="Hand" Command="{Binding ProductSearchCommand}" Margin="4,0,0,0"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="8,6" BorderBrush="#CCC" BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ProductSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <!-- Customer row -->
                    <Border Grid.Row="1" BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="8,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="+ Add" FontSize="10" Padding="6,2"
                                    Cursor="Hand" Command="{Binding OpenCustomerLookupCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#1A6AA5" CornerRadius="3" Padding="6,2">
                                            <ContentPresenter HorizontalAlignment="Center" TextBlock.Foreground="White"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#888">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="No customer"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AttachedCustomer}" Value="{x:Null}">
                                                <Setter Property="Text" Value="No customer"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Cart Items (Journal) -->
                    <ListView Grid.Row="2" ItemsSource="{Binding CartItems}" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0"
                              Background="White">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sku}" FontSize="10" Foreground="#999"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity}" FontSize="13" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat=C2}"
                                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Search Results Overlay -->
                    <Border Grid.Row="2" Background="White" Panel.ZIndex="10"
                            Visibility="{Binding SearchResults.Count, Converter={StaticResource BoolToVis}}">
                        <ListView ItemsSource="{Binding SearchResults}" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Cursor="Hand" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Price, StringFormat=C2}" DockPanel.Dock="Right"
                                                       FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                                <TextBlock Text="{Binding Sku}" FontSize="10" Foreground="#999"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Lines / Items count -->
                    <Border Grid.Row="3" Background="#F8F8F8" Padding="8,4" BorderBrush="#EEE" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock FontSize="12" Foreground="#666">
                                <Run Text="Lines: "/><Run Text="{Binding LineCount, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#666">
                                <Run Text="Total Items: "/><Run Text="{Binding TotalItemCount, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Totals -->
                    <Border Grid.Row="4" Background="#F0F0F0" Padding="10,8" BorderBrush="#1A6AA5" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SubTotal:" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat=C2}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="14" FontWeight="Bold">
                                    <Run Text="{Binding TaxRateDisplay, Mode=OneWay}"/><Run Text=":"/>
                                </TextBlock>
                                <TextBlock Text="{Binding TaxTotal, StringFormat=C2}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total:" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat=C2}" FontSize="16" FontWeight="Bold"
                                           Foreground="#1A6AA5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== RIGHT PANEL: Quick Buttons ===== -->
            <Border Grid.Column="1" Background="White" BorderBrush="#1A6AA5" BorderThickness="2" Margin="2,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding QuickButtons}" Margin="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Width="120" Style="{StaticResource QuickBtn}"
                                        Command="{Binding DataContext.QuickButtonClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ BOTTOM BAR: Payment + Action Buttons ============ -->
        <Border Grid.Row="2" Background="White" Padding="4" BorderBrush="#1A6AA5" BorderThickness="0,2,0,0">
            <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource PaymentBtn}" Command="{Binding PayCashCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="CASH" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" Command="{Binding PayCreditCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="CREDIT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" IsEnabled="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="PAYPAL" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" IsEnabled="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="GIFT CERT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" IsEnabled="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="STORE CREDIT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" IsEnabled="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="OTHER" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" IsEnabled="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="SPLIT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" Command="{Binding ToggleDiscountPanelCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="%" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#D4710A"/>
                        <TextBlock Text="DISCOUNT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" Command="{Binding VoidTransactionCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="VOID" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" IsEnabled="False">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="RETURN" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" Command="{Binding SuspendTransactionCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="SUSPEND" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PaymentBtn}" Command="{Binding ShowSuspendedCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="RESUME" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ============ OVERLAYS ============ -->

        <!-- Customer Lookup Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" Panel.ZIndex="20"
                Visibility="{Binding ShowCustomerLookup, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="20" MaxWidth="500" MaxHeight="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Customer Lookup" FontSize="18" FontWeight="Bold" Foreground="#1A6AA5"/>
                        <Button Content="X" DockPanel.Dock="Right" Command="{Binding CloseCustomerLookupCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button Content="Search" Command="{Binding SearchCustomersCommand}" DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,6"/>
                        <TextBox Text="{Binding CustomerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource RegisterTextBox}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCustomersCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <ListView ItemsSource="{Binding CustomerSearchResults}" MaxHeight="300" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.AttachCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="#999">
                                            <Run Text="{Binding Phone, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Email, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Border>

        <!-- Suspended Transactions Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" Panel.ZIndex="20"
                Visibility="{Binding ShowSuspendedList, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="20" MaxWidth="600" MaxHeight="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Suspended Transactions" FontSize="18" FontWeight="Bold" Foreground="#1A6AA5"/>
                        <Button Content="X" DockPanel.Dock="Right" Command="{Binding CloseSuspendedListCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                    </DockPanel>
                    <ListView ItemsSource="{Binding SuspendedTransactions}" MaxHeight="380" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" Margin="0,2" Background="#F8F8F8" CornerRadius="6" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ResumeTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=C2}" FontSize="16"
                                                   FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                <Run Text="Transaction #"/>
                                                <Run Text="{Binding Id, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#999">
                                                <Run Text="{Binding Items.Count, Mode=OneWay}"/> <Run Text="items"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Border>

        <!-- Discount Panel Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" Panel.ZIndex="20"
                Visibility="{Binding ShowDiscountPanel, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="24" MaxWidth="350"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Apply Discount" FontSize="18" FontWeight="Bold" Foreground="#1A6AA5" Margin="0,0,0,16"/>
                    <DockPanel Margin="0,0,0,8">
                        <ComboBox DockPanel.Dock="Right" Width="80" FontSize="14" Padding="4"
                                  SelectedValue="{Binding DiscountType}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="%" Tag="percentage"/>
                            <ComboBoxItem Content="$" Tag="fixed"/>
                        </ComboBox>
                        <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource RegisterTextBox}" FontSize="18" Margin="0,0,6,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyDiscountCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Clear" Command="{Binding ClearDiscountCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Apply" Command="{Binding ApplyDiscountCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,6"/>
                    </StackPanel>
                    <Button Content="Close" Command="{Binding ToggleDiscountPanelCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,12,0,0"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
