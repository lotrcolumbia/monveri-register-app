<UserControl x:Class="MonveriRegister.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MonveriRegister.ViewModels"
             d:DataContext="{d:DesignInstance vm:PaymentViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="550">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="32">
            <StackPanel>
                <!-- Header -->
                <DockPanel Margin="0,0,0,20">
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Credit Card Payment"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCash}" Value="True">
                                        <Setter Property="Text" Value="Cash Payment"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="Cancel" DockPanel.Dock="Right" Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                </DockPanel>

                <!-- Totals breakdown -->
                <Border Background="{StaticResource SurfaceDarkBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Subtotal" FontSize="14"/>
                            <TextBlock Text="{Binding Subtotal, StringFormat=C2}" DockPanel.Dock="Right" FontSize="14"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Discount" FontSize="14" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="{Binding Discount, StringFormat=-{0:C2}}" DockPanel.Dock="Right" FontSize="14"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Tax" FontSize="14"/>
                            <TextBlock Text="{Binding Tax, StringFormat=C2}" DockPanel.Dock="Right" FontSize="14"/>
                        </DockPanel>
                        <Separator Margin="0,8"/>
                        <DockPanel>
                            <TextBlock Text="TOTAL DUE" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalDue, StringFormat=C2}" DockPanel.Dock="Right" FontSize="28"
                                       FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Cash entry (only for cash) -->
                <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                    <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <!-- Tendered display -->
                        <TextBlock Text="Amount Tendered" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Border Background="White" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding TenderedEntry, FallbackValue='0.00'}" FontSize="32" FontWeight="Bold"
                                       HorizontalAlignment="Right" FontFamily="Consolas"/>
                        </Border>

                        <!-- Quick cash buttons -->
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <Button Content="Exact" Command="{Binding ExactCashCommand}" Style="{StaticResource SecondaryButton}" Margin="2"/>
                            <Button Content="$20" Command="{Binding QuickCashCommand}" CommandParameter="20" Style="{StaticResource SecondaryButton}" Margin="2"/>
                            <Button Content="$50" Command="{Binding QuickCashCommand}" CommandParameter="50" Style="{StaticResource SecondaryButton}" Margin="2"/>
                            <Button Content="$100" Command="{Binding QuickCashCommand}" CommandParameter="100" Style="{StaticResource SecondaryButton}" Margin="2"/>
                        </UniformGrid>

                        <!-- Numpad -->
                        <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Button Content="7" Command="{Binding AppendDigitCommand}" CommandParameter="7" Style="{StaticResource NumpadButton}"/>
                            <Button Content="8" Command="{Binding AppendDigitCommand}" CommandParameter="8" Style="{StaticResource NumpadButton}"/>
                            <Button Content="9" Command="{Binding AppendDigitCommand}" CommandParameter="9" Style="{StaticResource NumpadButton}"/>
                            <Button Content="4" Command="{Binding AppendDigitCommand}" CommandParameter="4" Style="{StaticResource NumpadButton}"/>
                            <Button Content="5" Command="{Binding AppendDigitCommand}" CommandParameter="5" Style="{StaticResource NumpadButton}"/>
                            <Button Content="6" Command="{Binding AppendDigitCommand}" CommandParameter="6" Style="{StaticResource NumpadButton}"/>
                            <Button Content="1" Command="{Binding AppendDigitCommand}" CommandParameter="1" Style="{StaticResource NumpadButton}"/>
                            <Button Content="2" Command="{Binding AppendDigitCommand}" CommandParameter="2" Style="{StaticResource NumpadButton}"/>
                            <Button Content="3" Command="{Binding AppendDigitCommand}" CommandParameter="3" Style="{StaticResource NumpadButton}"/>
                            <Button Content="CLR" Command="{Binding ClearEntryCommand}" Style="{StaticResource NumpadButton}" FontSize="14"/>
                            <Button Content="0" Command="{Binding AppendDigitCommand}" CommandParameter="0" Style="{StaticResource NumpadButton}"/>
                            <Button Content="." Command="{Binding AppendDecimalCommand}" Style="{StaticResource NumpadButton}"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Change display -->
                    <Border Background="{StaticResource SuccessBrush}" CornerRadius="8" Padding="16"
                            Visibility="{Binding ShowChange, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CHANGE DUE" FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ChangeAmount, StringFormat=C2}" FontSize="36" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Credit card placeholder (only for credit) -->
                <Border Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource SurfaceDarkBrush}" CornerRadius="8" Padding="24" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="Ready for Card" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Present card to terminal or tap to process" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Process / Complete buttons -->
                <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Button Content="Process Payment" Command="{Binding ProcessPaymentCommand}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                            FontSize="18" Padding="0,14" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCredit}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource CreditBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Completion -->
                <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Payment Complete!" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>
                    <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16">
                        <Run Text="Receipt:"/>
                        <Run Text="{Binding ReceiptToken, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="New Transaction" Command="{Binding NewTransactionCommand}"
                            Style="{StaticResource PrimaryButton}" FontSize="16" Padding="0,14" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
