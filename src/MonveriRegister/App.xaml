<Application x:Class="MonveriRegister.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonveriRegister"
             xmlns:vm="clr-namespace:MonveriRegister.ViewModels"
             xmlns:views="clr-namespace:MonveriRegister.Views"
             xmlns:conv="clr-namespace:MonveriRegister.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:CurrencyConverter x:Key="Currency"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>

            <!-- View-ViewModel mappings -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegisterOpenCloseViewModel}">
                <views:RegisterOpenCloseView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
                <views:RegisterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PaymentViewModel}">
                <views:PaymentView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
